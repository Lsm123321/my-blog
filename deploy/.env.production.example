# 复制为 deploy/.env 后填写真实值（docker compose 会自动读取同目录 .env）

# 你的域名（需已解析到服务器 IP）
WEB_URL=https://your-domain.com

# JWT 密钥 —— 必改！生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# 首次建站管理员密码（留空则随机生成，用 docker logs blog-server 查看）
SEED_OWNER_PASSWORD=
OWNER_NAME=lsm
