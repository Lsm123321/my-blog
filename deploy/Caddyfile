# Caddy 反向代理 + 自动 HTTPS
# 域名替换为你的真实域名（需已解析 A 记录到服务器 IP）；Caddy 自动申请续期证书
#
# ⚠ 当前服务器（154.219.116.58）实际运行的是 IP 模式（:80，无域名）版本。
# 若无域名直接部署，请把下面的站点块整体替换为 ":80 {"，否则 Caddy 会因
# your-domain.com 证书申请失败而把所有 HTTP 请求 308 跳转到打不开的 HTTPS。
# 绑定真实域名后，改回此文件并 docker compose restart caddy 即可自动上 HTTPS。
your-domain.com {
	# 压缩
	encode gzip

	# 后端 API
	handle /api/v2/* {
		reverse_proxy server:2333
	}

	# 上传的图片/音频
	handle /uploads/* {
		reverse_proxy server:2333
	}

	# 管理后台（建议配合防火墙仅放行自己的 IP，或改用非常规路径）
	handle /admin* {
		reverse_proxy server:2333
	}

	# 后端根静态资源（avatar 等；favicon 由前端 public 提供）
	handle /avatar.png {
		reverse_proxy server:2333
	}

	# 其余全部交给 Shiro 前端
	handle {
		reverse_proxy web:2323
	}
}
