# 域名模式：Caddy 自动申请并续期 Let's Encrypt 证书
#
# ⚠ 当前服务器（154.219.116.58）的部署形态：
#   HTTPS 统一由 timbersage 项目的 caddy 容器反代（两台 caddy 不能同时抢 443），
#   站点块已合并进 /root/TimberSage/Caddyfile，博客 web/server 容器接入
#   timbersage_default 网络由它转发；本目录的 Caddyfile 与 compose 里的
#   caddy 服务仅作为「单机独立部署」的备用方案保留（不参与当前运行）。
#
# 独立部署时：把下面的域名换成你的，docker compose up -d 即可自动 HTTPS。
blog.laozu.us.ci {
	encode gzip

	# 后端 API
	handle /api/v2/* {
		reverse_proxy server:2333
	}

	# 上传的图片/音频
	handle /uploads/* {
		reverse_proxy server:2333
	}

	# 管理后台（建议配合防火墙仅放行自己的 IP，或改用非常规路径）
	handle /admin* {
		reverse_proxy server:2333
	}

	# 后端根静态资源（avatar 等；favicon 由前端 public 提供）
	handle /avatar.png {
		reverse_proxy server:2333
	}

	# 其余全部交给 Shiro 前端
	handle {
		reverse_proxy web:2323
	}
}
